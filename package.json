{
  "name": "@schleegleixner/react-statamic-api",
  "version": "1.11.3",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "react-statamic-flush": "./dist/cli/flush.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./pwa/next": {
      "types": "./dist/pwa/next.d.ts",
      "import": "./dist/pwa/next.js",
      "require": "./dist/pwa/next.js"
    },
    "./pwa/sw": {
      "types": "./dist/pwa/sw.d.ts",
      "import": "./dist/pwa/sw.js",
      "require": "./dist/pwa/sw.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:cli",
    "build:cli": "esbuild src/cli/flush.ts --bundle --platform=node --format=cjs --banner:js='#!/usr/bin/env node' --external:sharp --outfile=dist/cli/flush.cjs",
    "flush:statamic": "node ./dist/cli/flush.cjs",
    "dev": "tsc -w -p tsconfig.build.json & tsc-alias -w -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "devDependencies": {
    "@serwist/next": "^9.5.11",
    "serwist": "^9.5.11",
    "@types/node": "^24.3.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "echarts": "^6.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^16.4.7",
    "fathom-client": "^3.7.2",
    "p-limit": "^7.1.1",
    "papaparse": "^5.5.3",
    "remark": "^15.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "peerDependencies": {
    "echarts": "^6.0.0",
    "sharp": "^0.34.3",
    "next": "^16.0.0",
    "react": "^19.1.8",
    "react-dom": "^19.1.6",
    "@serwist/next": "^9.5.0",
    "serwist": "^9.5.0"
  },
  "peerDependenciesMeta": {
    "@serwist/next": {
      "optional": true
    },
    "serwist": {
      "optional": true
    }
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "overrides": {
    "minimatch": ">=10.2.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true
  }
}
